{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "igs-iec104-runtime events",
  "description": "An event of the client role, as the control API reports it (GET /v1/events). Versioned with runtime-api.yaml: both carry the same contract version.",
  "$comment": "contract version 1.1.0",
  "$ref": "#/$defs/Event",
  "$defs": {
    "Event": {
      "description": "One recorded event: its kind selects the fields that follow it.",
      "oneOf": [
        {
          "$ref": "#/$defs/Connected"
        },
        {
          "$ref": "#/$defs/Disconnected"
        },
        {
          "$ref": "#/$defs/ConnectFailed"
        },
        {
          "$ref": "#/$defs/Discarded"
        },
        {
          "$ref": "#/$defs/Transfer"
        },
        {
          "$ref": "#/$defs/Asdu"
        },
        {
          "$ref": "#/$defs/Transmitted"
        },
        {
          "$ref": "#/$defs/Rejected"
        },
        {
          "$ref": "#/$defs/Unacknowledged"
        },
        {
          "$ref": "#/$defs/Closed"
        },
        {
          "$ref": "#/$defs/Verdict"
        }
      ]
    },
    "Connected": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "connected"
        }
      },
      "additionalProperties": false
    },
    "Disconnected": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind",
        "error"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "disconnected"
        },
        "error": {
          "type": "string",
          "description": "The error that ended the connection, as text."
        }
      },
      "additionalProperties": false
    },
    "ConnectFailed": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind",
        "error"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "connect_failed"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Discarded": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind",
        "command"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "discarded"
        },
        "command": {
          "type": "string",
          "description": "The request, as text. It was not sent."
        }
      },
      "additionalProperties": false
    },
    "Transfer": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind",
        "state"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "transfer"
        },
        "state": {
          "$ref": "#/$defs/TransferState"
        }
      },
      "additionalProperties": false
    },
    "Asdu": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind",
        "asdu"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "asdu"
        },
        "asdu": {
          "$ref": "#/$defs/AsduView"
        }
      },
      "additionalProperties": false
    },
    "Transmitted": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind",
        "asdu"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "transmitted"
        },
        "asdu": {
          "$ref": "#/$defs/AsduView"
        }
      },
      "additionalProperties": false
    },
    "Rejected": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind",
        "detail"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "rejected"
        },
        "detail": {
          "type": "string",
          "description": "Why a request was not carried out, as text."
        }
      },
      "additionalProperties": false
    },
    "Unacknowledged": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind",
        "asdus"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "unacknowledged"
        },
        "asdus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AsduView"
          }
        }
      },
      "additionalProperties": false
    },
    "Closed": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequence number, from 1, with no gap while the events are kept."
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "The time the event was recorded: milliseconds since the Unix epoch, UTC."
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "The connection generation the event was recorded in: the number of connections so far."
        },
        "kind": {
          "const": "closed"
        }
      },
      "additionalProperties": false
    },
    "TransferState": {
      "type": "string",
      "enum": [
        "stopped",
        "pending_started",
        "started",
        "pending_stopped",
        "pending_unconfirmed_stop"
      ]
    },
    "AsduView": {
      "type": "object",
      "required": [
        "type_id",
        "cause",
        "negative",
        "common_address",
        "bytes_hex"
      ],
      "properties": {
        "type_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "The type identification."
        },
        "cause": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63,
          "description": "The cause of transmission, without the P/N and test bits."
        },
        "negative": {
          "type": "boolean",
          "description": "The P/N bit: a negative confirmation."
        },
        "common_address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bytes_hex": {
          "description": "The encoding of the ASDU, in lower-case hexadecimal, or null when it cannot be encoded. The decoded values come with the point image (task C2).",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{2})*$"
        }
      },
      "additionalProperties": false
    },
    "Verdict": {
      "type": "object",
      "required": [
        "seq",
        "observed_at_ms",
        "generation",
        "kind",
        "request",
        "outcome",
        "sent",
        "cause",
        "negative",
        "transmitted_generation"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "const": "verdict"
        },
        "request": {
          "type": "integer",
          "minimum": 1,
          "description": "The request this verdict ends."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "confirmed",
            "refused",
            "timed_out",
            "cancelled",
            "indeterminate",
            "not_sent"
          ]
        },
        "sent": {
          "type": "boolean",
          "description": "Whether the request's I frame was written to the connection."
        },
        "cause": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 63,
          "description": "For a refusal: the cause of the station's answer."
        },
        "negative": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "For a refusal: true for a negative confirmation."
        },
        "transmitted_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "The connection generation the request was written on, if it was."
        }
      },
      "additionalProperties": false
    }
  }
}
